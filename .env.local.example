# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional tour assistant. Server-only; never use NEXT_PUBLIC_ for these.
# Set these in .env.local, then rebuild/restart the editor server.
OPENAI_API_KEY=
OPENAI_MODEL=
TOUR_AI_ENABLED=false
